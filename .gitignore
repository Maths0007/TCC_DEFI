# Environments & Virtual Envs
.venv/
env/
venv/
__pycache__/
*.pyc

# Exclude local drafts, office files and unwhitelisted PDFs
texto_tcc/
apresentacao/
*.pptx
*.docx
*.pdf
gerar_pptx.py

# Local raw downloads, discarded drafts and legacy directories
/artigos_baixados/
/artigos_descartados/
/artigos_manter/
